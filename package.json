{
  "name": "tvmaze",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf $TMPDIR/react-* && watchman watch-del-all",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "android:detox:build": "detox build --configuration android.emu.debug -l verbose",
    "android:detox:test": "detox test --configuration android.emu.debug -l verbose --debug-synchronization 500",
    "ios:detox:build": "detox build --configuration ios -l verbose",
    "ios:detox:test": "detox test --configuration ios -l verbose",
    "android:prod:detox:build": "detox build --configuration android.emu.release -l verbose",
    "android:prod:detox:test": "detox test --configuration android.emu.release -l verbose",
    "lint": "eslint --ext .tsx ./src/",
    "format": "prettier --check ./src",
    "typescript": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.0",
    "@react-navigation/stack": "^6.4.1",
    "@rodrigorbrg/app-ui": "^1.0.0",
    "@rodrigorbrg/my-ui-components": "^0.1.3",
    "axios": "^1.7.7",
    "moment": "^2.30.1",
    "react": "18.2.0",
    "react-native": "0.74.3",
    "react-native-elements": "3.4.2",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-reanimated": "3.9.0",
    "react-native-safe-area-context": "^4.10.7",
    "react-native-screens": "^3.32.0",
    "react-native-svg": "^12.3.0",
    "react-native-vector-icons": "9.1.0",
    "react-native-view-shot": "^3.1.2",
    "react-navigation": "4.4.4",
    "react-redux": "7.2.6",
    "redux": "4.1.2",
    "redux-persist": "6.0.0",
    "redux-thunk": "2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-display-name": "^7.24.7",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.85",
    "@react-native/eslint-config": "0.74.85",
    "@react-native/metro-config": "0.74.85",
    "@react-native/typescript-config": "0.74.85",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^19.7.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-native-debugger": "^1.1.0",
    "react-native-dotenv": "3.4.9",
    "react-native-tab-view": "^3.5.2",
    "react-native-toast-message": "^2.1.5",
    "react-test-renderer": "18.2.0",
    "reactotron-react-native": "^5.0.3",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "./jestSetupFile.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!native-base)/"
    ]
  }
}
